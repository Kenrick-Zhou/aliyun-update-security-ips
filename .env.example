# 阿里云访问密钥配置
# 请将此文件复制为 .env 并填入你的实际密钥

# 阿里云 Access Key ID
ALY_AK=your_access_key_id_here

# 阿里云 Access Key Secret
ALY_SK=your_access_key_secret_here

# ===== 通知配置（可选） =====
# 在 config.yml 中设置 Notification.enabled=true 和 Notification.type 来启用

# Bark 推送服务密钥（当 config.yml 中 Notification.type=bark 时需要）
# 格式：https://api.day.app/your_key 或自建服务器地址
# 获取方式：从 Bark App 中复制完整的服务器地址（末尾的 / 会自动处理）
BARK_KEY=https://api.day.app/your_bark_key_here

# PushDeer 推送服务密钥（当 config.yml 中 Notification.type=pushdeer 时需要）
# 获取方式：从 PushDeer 获取 pushkey
PUSHDEER_KEY=your_pushdeer_key_here

